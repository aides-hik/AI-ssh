{
  "name": "ai-ssh-assistant",
  "version": "1.9.4",
  "description": "Prism — AI-powered SSH workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm build:database && concurrently \"pnpm dev:server\" \"pnpm dev:desktop\"",
    "devall": "pnpm build:database && pnpm build:shared && pnpm dev:desktop",
    "dev:desktop": "pnpm --filter @ai-ssh/desktop dev",
    "preview:design": "pnpm --filter @ai-ssh/desktop dev:design",
    "dev:server": "pnpm --filter @ai-ssh/server dev:debug",
    "build:database": "pnpm --filter @ai-ssh/database build",
    "build": "pnpm build:shared && pnpm build:database && pnpm build:server",
    "build:shared": "pnpm --filter @ai-ssh/shared build",
    "build:server": "pnpm --filter @ai-ssh/server build",
    "build:desktop": "pnpm --filter @ai-ssh/desktop build:skip-check",
    "test": "pnpm --recursive --if-present test",
    "lint": "eslint apps/desktop packages/server/src packages/database/src packages/shared/src scripts eslint.config.mjs",
    "type-check": "pnpm --recursive type-check",
    "clean": "pnpm --recursive clean && rimraf node_modules",
    "db:generate": "pnpm --filter @ai-ssh/database db:generate",
    "db:push": "pnpm --filter @ai-ssh/database db:push",
    "db:migrate": "pnpm --filter @ai-ssh/database db:migrate",
    "db:seed": "pnpm --filter @ai-ssh/database db:seed",
    "db:studio": "pnpm --filter @ai-ssh/database db:studio",
    "docker:pull": "docker compose pull",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate:deploy": "pnpm --filter @ai-ssh/database db:migrate:deploy"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@eslint/js": "10.0.1",
    "eslint-plugin-vue": "10.11.1",
    "vue-eslint-parser": "10.4.1",
    "globals": "17.13.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1",
    "pnpm": "12.15.0"
  }
}
