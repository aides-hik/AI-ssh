# Optional self-hosted backend. Defaults to this local address in every build.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Updates are disabled unless a source is explicitly configured.
# VITE_UPDATE_REPOSITORY=your-account/your-repository
# A direct manifest URL takes priority; placeholders select the current build.
# VITE_UPDATE_MANIFEST_URL=https://updates.example.test/update-manifest-{platform}-{arch}.json

# Electron runtime overrides (set in the process environment, not in this file):
# AI_SSH_API_BASE_URL, AI_SSH_UPDATE_REPOSITORY, AI_SSH_UPDATE_MANIFEST_URL
