# 生产环境配置示例
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 数据库（必需）
DATABASE_URL=postgresql://username:password@localhost:5432/ai_ssh_assistant

# JWT（必需，至少32字符）
JWT_SECRET=change-me-to-random-32-chars-or-more
JWT_EXPIRES_IN=7d

# 安全（必需）
ENCRYPTION_KEY=change-me-to-exactly-32-chars
SESSION_SECRET=change-me-to-random-32-chars-or-more
SESSION_MAX_AGE=86400

# 可选自托管 AI（默认关闭，全部由部署者自行配置）
OFFICIAL_AI_ENABLED=false
OFFICIAL_AI_BASE_URL=
OFFICIAL_AI_API_KEY=
# 逗号分隔的自托管模型 ID；启用时必须同时配置上游 URL 和模型
OFFICIAL_AI_MODELS=
# 0 表示不设每日调用上限
OFFICIAL_AI_DAILY_LIMIT=0
OFFICIAL_AI_TIMEOUT_MS=60000
OFFICIAL_AI_TIMEZONE=Asia/Shanghai

# 其他配置使用默认值即可
