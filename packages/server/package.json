{
  "name": "@ai-ssh/server",
  "version": "1.9.8",
  "description": "Prism Server API",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore=node_modules/** src/index.ts",
    "dev:clean": "rimraf node_modules/.tsx && tsx watch --clear-screen=false src/index.ts",
    "dev:debug": "node scripts/clean-ports.js && tsx watch --inspect=9229 --clear-screen=false src/index.ts",
    "debug": "node --inspect --import tsx/esm src/index.ts",
    "build": "tsc --build --force && tsc-alias",
    "build:bundle": "node build.config.mjs",
    "start": "node dist/index.js",
    "start:bundle": "node dist-bundle/index.js",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist dist-bundle"
  },
  "dependencies": {
    "@ai-ssh/database": "workspace:*",
    "@ai-ssh/shared": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "fs-extra": "11.4.1",
    "i18next": "26.5.5",
    "i18next-fs-backend": "2.6.9",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "mime-types": "3.0.2",
    "minio": "8.0.7",
    "node-cron": "4.6.0",
    "openai": "7.42.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "rotating-file-stream": "3.2.10",
    "sharp": "0.35.5",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.6.5",
    "@types/node-cron": "3.0.11",
    "@types/ssh2": "1.15.6",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsc-alias": "1.9.9",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
