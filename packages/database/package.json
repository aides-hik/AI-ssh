{
  "name": "@ai-ssh/database",
  "version": "1.8.32",
  "description": "AI SSH Assistant Database Layer",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./postgres": {
      "types": "./dist/src/postgres.d.ts",
      "import": "./dist/src/postgres.js",
      "require": "./dist/src/postgres.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "prisma generate --schema prisma/schema-postgresql.prisma && prisma generate --config prisma.sqlite.config.ts --schema prisma/schema-sqlite.prisma && tsc --build --force",
    "dev": "tsc --watch",
    "db:generate": "prisma generate --schema prisma/schema-postgresql.prisma && prisma generate --config prisma.sqlite.config.ts --schema prisma/schema-sqlite.prisma",
    "db:push": "prisma db push --schema prisma/schema-postgresql.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema-postgresql.prisma",
    "db:migrate:reset": "prisma migrate reset --force --schema prisma/schema-postgresql.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema-postgresql.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "db:format": "prisma format --schema prisma/schema-postgresql.prisma && prisma format --config prisma.sqlite.config.ts --schema prisma/schema-sqlite.prisma",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "node ../../scripts/run-node-tests.mjs packages/database"
  },
  "dependencies": {
    "@ai-ssh/shared": "workspace:*",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "nanoid": "6.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "dotenv": "18.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/pg": "8.23.1"
  }
}
