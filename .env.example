# 服务端配置示例：复制到 packages/server/.env 后填写自己的配置
DATABASE_URL="postgresql://ai_ssh_user:change-me@127.0.0.1:5432/ai_ssh_assistant"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=your-super-secret-jwt-key-change-in-production-123456789
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SESSION_SECRET=your-session-secret-key-change-in-production-123456789
SESSION_MAX_AGE=86400

# 自有模型服务；桌面端自定义模型直接在设置中配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 可选自托管 AI 代理：默认关闭，启用时配置自己的上游与模型
OFFICIAL_AI_ENABLED=false
OFFICIAL_AI_BASE_URL=
OFFICIAL_AI_API_KEY=
OFFICIAL_AI_MODELS=
OFFICIAL_AI_DAILY_LIMIT=0

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=3600
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads
LOG_LEVEL=info
LOG_DIR=./logs

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENABLE_METRICS=true
METRICS_PORT=9090
DEBUG=false
ENABLE_DOCS=true
ENABLE_DEVTOOLS=true
